.venv/
__pycache__/
*.pyc
# Контент-проекты целиком: это работа человека, а не продукт. Раньше
# игнорировались только медиа, и тексты проекта уезжали в репозиторий — на
# публичном GitHub это чужая интеллектуальная собственность в открытом доступе.
projects/*
!projects/.gitkeep
spike/
.pytest_cache/
.understand-anything/
.env
.env.*
!.env.example
graphify-out/

montage/node_modules/
montage/out/

# рабочие артефакты инструментов, на чужой машине не нужны
.superpowers/
.claude/settings.local.json
.playwright-mcp/

# кэш каталога моделей: тянется из сети, в репозитории не нужен
openrouter-models.json

# Рабочая память проекта: планы, спеки, исследования и правила для агента.
# На GitHub уезжает работающий продукт, а не история того, как о нём думали.
# Файлы остаются на диске — ими пользуются будущие сессии.
docs/
CLAUDE.md
