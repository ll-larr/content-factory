# Ключи провайдеров. Скопируй в .env и подставь свои значения.
#
#   cp .env.example .env
#
# .env в .gitignore и в репозиторий не попадает. Значений здесь нет и быть не
# должно: этот файл — список имён, а не хранилище.
#
# Нужен только ключ того провайдера, который выбран в project.json. Отсутствующий
# ключ конвейер ловит до сметы и выходит кодом 2, а не падает на середине оплаты.

# Речь, эффекты, музыка, липсинк; часть видео- и image-моделей.
WAVESPEED_API_KEY=

# Кадры и видеоотрезки. На нём же самые дешёвые из проверенных живьём моделей.
RUNWARE_API_KEY=

# Ещё один поставщик ВИДЕО и картинок (kling3_0, seedance_2_0, veo3_1_lite,
# seedream). Он же — движок ТЕКСТОВЫХ стадий (идея, сценарий, раскадровка) на
# машине без Claude Code: модель выбирает человек в панели.
OPENROUTER_API_KEY=

# Поиск для проверки фактов познавательного жанра. Нужен только там, где нет
# Claude Code: агент ищет своими инструментами, модель по ключу — не умеет.
# Без этого ключа И без Claude Code познавательный жанр недоступен: проверяющему
# запрещено верить источнику автора, он обязан искать сам.
TAVILY_API_KEY=
